<Application x:Class="Quizly.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Quizly.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Background Gradient -->
        <LinearGradientBrush x:Key="Bg" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FF1EA7E9" Offset="0"/>
            <GradientStop Color="#FF4D5BE0" Offset="0.45"/>
            <GradientStop Color="#FF3A43B9" Offset="1"/>
        </LinearGradientBrush>

        <!-- Brushes -->
        <SolidColorBrush x:Key="White" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#D9E3FF"/>
        <SolidColorBrush x:Key="Card" Color="#22000000"/>
        <SolidColorBrush x:Key="CardStrong" Color="#2D000000"/>

        <SolidColorBrush x:Key="Green" Color="#FF22C55E"/>
        <SolidColorBrush x:Key="BlueBtn" Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="DarkBtn" Color="#FF2B2F6D"/>

        <!-- Base rounded button -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small circle icon button -->
        <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Match card style -->
        <Style x:Key="MatchCard" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Application.Resources>
</Application>
