<UserControl x:Class="Quizly.Views.SinglePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Nur Zurück-Button -->
        <Grid Grid.Row="0" Margin="0,3,0,8">
            <Button HorizontalAlignment="Left"
                    Style="{StaticResource CircleButton}" 
                    Content="←" 
                    Click="Back_Click"/>
        </Grid>

        <!-- Status-Text und Score -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- "Singleplayer Training" Text -->
            <TextBlock Grid.Row="0"
                       Text="Singleplayer Training"
                       Foreground="#FFC857"
                       FontSize="22" 
                       FontWeight="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"
                       x:Name="StatusText"/>

            <!-- Score und Spieler -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Linker Spieler (Du) -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="45" Height="45" Fill="#4DD4E8" Margin="0,0,0,3">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Du" 
                               Foreground="{StaticResource White}" 
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               x:Name="Player1Name"/>
                </StackPanel>

                <!-- Score in der Mitte -->
                <TextBlock Grid.Column="1"
                           Text="0 / 18"
                           Foreground="{StaticResource White}"
                           FontSize="36" 
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="10,0"
                           x:Name="FinalScore"/>

                <!-- Rechts: Ziel-Punkte -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎯" 
                               FontSize="32"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                    <TextBlock Text="Ziel" 
                               Foreground="{StaticResource White}" 
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Runden-Übersicht ohne ScrollViewer -->
        <Viewbox Grid.Row="2" Stretch="Uniform">
            <StackPanel Width="450">
                <!-- Runde 1 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Spieler Ellipsen -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5" x:Name="R1Q1"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5" x:Name="R1Q2"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Opacity="0.5" x:Name="R1Q3"/>
                    </StackPanel>

                    <!-- Icon + Text in der Mitte -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                        <Border Background="#1A2A5E" 
                                Width="42" Height="42" 
                                CornerRadius="21"
                                Margin="0,0,0,2"
                                Opacity="0.5"
                                x:Name="R1Border">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="1" FontSize="18" FontWeight="Black" Foreground="{StaticResource White}" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="R1Icon"/>
                        </Border>
                        <TextBlock Text="Runde 1" 
                                   Foreground="{StaticResource White}" 
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   x:Name="R1Category"/>
                    </StackPanel>

                    <!-- Punkte rechts -->
                    <TextBlock Grid.Column="2" 
                               Text="0 / 3" 
                               Foreground="{StaticResource Muted}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               x:Name="R1Score"/>
                </Grid>

                <!-- Runde 2 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                        <Border Background="#1A2A5E" Width="42" Height="42" CornerRadius="21" Margin="0,0,0,2" Opacity="0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="2" FontSize="18" FontWeight="Black" Foreground="{StaticResource White}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Runde 2" Foreground="{StaticResource White}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="0 / 3" Foreground="{StaticResource Muted}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Runde 3 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                        <Border Background="#1A2A5E" Width="42" Height="42" CornerRadius="21" Margin="0,0,0,2" Opacity="0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="3" Foreground="{StaticResource White}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Runde 3" Foreground="{StaticResource White}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="0 / 3" Foreground="{StaticResource Muted}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Runde 4 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                        <Border Background="#1A2A5E" Width="42" Height="42" CornerRadius="21" Margin="0,0,0,2" Opacity="0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="4" Foreground="{StaticResource White}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Runde 4" Foreground="{StaticResource White}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="0 / 3" Foreground="{StaticResource Muted}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Runde 5 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                        <Border Background="#1A2A5E" Width="42" Height="42" CornerRadius="21" Margin="0,0,0,2" Opacity="0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="5" Foreground="{StaticResource White}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Runde 5" Foreground="{StaticResource White}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="0 / 3" Foreground="{StaticResource Muted}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Runde 6 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Margin="0,0,4,0" Opacity="0.5"/>
                        <Ellipse Width="28" Height="28" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                        <Border Background="#1A2A5E" Width="42" Height="42" CornerRadius="21" Margin="0,0,0,2" Opacity="0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="6" Foreground="{StaticResource White}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Runde 6" Foreground="{StaticResource White}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="0 / 3" Foreground="{StaticResource Muted}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Viewbox>

        <!-- Button unten -->
        <Button Grid.Row="3"
                Style="{StaticResource PillButton}"
                Background="{StaticResource Green}"
                Content="Spielen"
                Margin="0,10,0,0"
                Height="45"
                FontSize="16"
                FontWeight="Bold"
                Click="Play_Click"/>
    </Grid>
</UserControl>