<UserControl x:Class="Quizly.Views.BottomNavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#00FFFFFF">

    <Border Background="#EFFFFFFF" CornerRadius="18" Margin="12" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Background="#00FFFFFF" BorderThickness="0" Click="Home_Click">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Start" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Background="#00FFFFFF" BorderThickness="0" Click="Friends_Click">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Freunde" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
