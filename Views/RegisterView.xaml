<UserControl x:Class="Quizly.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource CircleButton}" Content="←" Click="Back_Click"/>
            <TextBlock Grid.Column="1" Text="Konto erstellen"
                       Foreground="{StaticResource White}"
                       FontSize="22" FontWeight="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel  Margin="0,0,0,18">

                <!-- Avatar -->
                <StackPanel HorizontalAlignment="Center"  Margin="0,4,0,6">
                    <Button Width="96" Height="96"
                            Background="#22FFFFFF"
                            BorderThickness="0"
                            Click="PickAvatar_Click"
                            Cursor="Hand">
                        <Border CornerRadius="48" ClipToBounds="True">
                            <Image x:Name="AvatarPreview" Stretch="UniformToFill"/>
                        </Border>
                    </Button>
                    <TextBlock Text="Avatar auswählen" Foreground="{StaticResource Muted}" />
                </StackPanel>

                <!-- Inputs -->
                <TextBlock Text="Name" Foreground="{StaticResource White}" FontWeight="Bold"/>
                <TextBox x:Name="NameBox" Height="44" FontSize="16"
                         Background="#33FFFFFF" BorderThickness="0"
                         Foreground="White" Padding="12,8"/>

                <TextBlock Text="Benutzername" Foreground="{StaticResource White}" FontWeight="Bold"/>
                <TextBox x:Name="UsernameBox" Height="44" FontSize="16"
                         Background="#33FFFFFF" BorderThickness="0"
                         Foreground="White" Padding="12,8"/>

                <TextBlock Text="E-Mail" Foreground="{StaticResource White}" FontWeight="Bold"/>
                <TextBox x:Name="EmailBox" Height="44" FontSize="16"
                         Background="#33FFFFFF" BorderThickness="0"
                         Foreground="White" Padding="12,8"/>

                <TextBlock Text="Passwort" Foreground="{StaticResource White}" FontWeight="Bold"/>
                <PasswordBox x:Name="PasswordBox" Height="44" FontSize="16"
                             Background="#33FFFFFF" BorderThickness="0"
                             Foreground="White" Padding="12,8"/>

                <TextBlock Text="Passwort wiederholen" Foreground="{StaticResource White}" FontWeight="Bold"/>
                <PasswordBox x:Name="PasswordRepeatBox" Height="44" FontSize="16"
                             Background="#33FFFFFF" BorderThickness="0"
                             Foreground="White" Padding="12,8"/>

                <!-- Error / Info -->
                <TextBlock x:Name="ErrorText"
                           Foreground="#FFFFA3A3"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />

                <!-- Actions -->
                <Button Style="{StaticResource PillButton}"
                        Background="{StaticResource Green}"
                        Content="Konto anlegen"
                        Height="58"
                        Click="Create_Click"/>

                <Button Style="{StaticResource PillButton}"
                        Background="{StaticResource DarkBtn}"
                        Content="Schon ein Konto? Einloggen"
                        Height="52"
                        FontSize="16"
                        Click="GoLogin_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
