<UserControl x:Class="Quizly.Views.DuelOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,6,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource CircleButton}" Content="←" Click="Back_Click"/>
            <TextBlock Grid.Column="1" Text="Du bist dran"
                       Foreground="#FFFFC857"
                       FontSize="30" FontWeight="Black"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="2  -  1"
                       Foreground="{StaticResource White}"
                       FontSize="48" FontWeight="Black"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="8">
                    <Ellipse Width="64" Height="64" Fill="#55FFFFFF"/>
                    <TextBlock Text="guest#25318401" Foreground="{StaticResource White}" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center"  Margin="12,0">
                    <TextBlock Text="Runden" Foreground="{StaticResource Muted}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="1" Rows="6">
                        <Border Background="#18000000" CornerRadius="26" Padding="12" Margin="0,0,0,10" Width="120">
                            <TextBlock Text="1" Foreground="{StaticResource White}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#18000000" CornerRadius="26" Padding="12" Margin="0,0,0,10" Width="120">
                            <TextBlock Text="2" Foreground="{StaticResource Muted}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#18000000" CornerRadius="26" Padding="12" Margin="0,0,0,10" Width="120">
                            <TextBlock Text="3" Foreground="{StaticResource Muted}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#18000000" CornerRadius="26" Padding="12" Margin="0,0,0,10" Width="120">
                            <TextBlock Text="4" Foreground="{StaticResource Muted}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#18000000" CornerRadius="26" Padding="12" Margin="0,0,0,10" Width="120">
                            <TextBlock Text="5" Foreground="{StaticResource Muted}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#18000000" CornerRadius="26" Padding="12" Width="120">
                            <TextBlock Text="6" Foreground="{StaticResource Muted}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="8">
                    <Ellipse Width="64" Height="64" Fill="#55FFFFFF"/>
                    <TextBlock Text="guest#97821195" Foreground="{StaticResource White}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Button Grid.Row="2" Style="{StaticResource PillButton}"
                Background="{StaticResource Green}"
                Content="Spielen"
                Margin="0,14,0,0"
                Click="Play_Click"/>
    </Grid>
</UserControl>
