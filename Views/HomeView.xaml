<UserControl x:Class="Quizly.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,6,0,14" >

            <TextBlock Text="Start"
               Foreground="{StaticResource White}"
               FontSize="24"
               FontWeight="Black"/>

            <!-- NEUER grüner Button -->
            <Button Style="{StaticResource PillButton}"
            Background="{StaticResource Green}"
            Content="Neues Spiel"
            Height="64"
            FontSize="20"
            Click="NewMatch_Click"/>
        </StackPanel>


        <!-- Scroll content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Laufende Spiele"
                           Foreground="{StaticResource White}"
                           FontSize="18" FontWeight="Black"
                           Margin="0,0,0,10"/>

                <Border Style="{StaticResource MatchCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="44" Height="44" Fill="#55FFFFFF" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="guest#97821195" Foreground="{StaticResource White}" FontWeight="Bold"/>
                            <TextBlock Text="Du bist dran" Foreground="#FFFFC857" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PillButton}"
                                Background="{StaticResource Green}"
                                Height="44" FontSize="16"
                                Content="Spielen" Click="OpenMatch_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="Beendete Spiele"
                           Foreground="{StaticResource White}"
                           FontSize="18" FontWeight="Black"
                           Margin="0,18,0,10"/>

                <Border Style="{StaticResource MatchCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="44" Height="44" Fill="#55FFFFFF" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="QuizMaster" Foreground="{StaticResource White}" FontWeight="Bold"/>
                            <TextBlock Text="Beendet • 510 : 540" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PillButton}"
                                Background="{StaticResource BlueBtn}"
                                Height="44" FontSize="16"
                                Content="Ansehen" Click="OpenMatch_Click"/>
                    </Grid>
                </Border>

                <Border Height="20" Background="#00000000"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Overlay: Neues Spiel -->
        <Grid x:Name="NewGameOverlay" Visibility="Collapsed">
            <Border Background="#AA000000"/>

            <Border Background="#EFFFFFFF"
                    CornerRadius="22"
                    Padding="18"
                    Width="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Margin="14">

                    <TextBlock Text="Neues Spiel"
                               FontSize="18"
                               FontWeight="Black"
                               Foreground="#1E2A6A"
                               TextAlignment="Center"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PillButton}"
                                Background="{StaticResource Green}"
                                Content="Gegner suchen"
                                Height="70"
                                FontSize="16"
                                Click="FindOpponent_Click"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource PillButton}"
                                Background="{StaticResource BlueBtn}"
                                Content="Mit Freund"
                                Height="70"
                                FontSize="16"
                                Margin="10,0,0,0"
                                Click="PlayWithFriend_Click"/>
                    </Grid>

                    <Button Style="{StaticResource PillButton}"
                            Background="{StaticResource DarkBtn}"
                            Content="Schließen"
                            Height="52"
                            Click="CloseOverlay_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
