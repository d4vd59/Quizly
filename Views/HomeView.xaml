<UserControl x:Class="Quizly.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: Avatar + Start + Neues Spiel -->
        <Grid Grid.Row="0" Margin="0,6,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Width="54" Height="54"
                        Background="#22FFFFFF"
                        BorderThickness="0"
                        Click="Avatar_Click"
                        Cursor="Hand">
                    <Border CornerRadius="27" ClipToBounds="True">
                        <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
                    </Border>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="Start"
                           Foreground="{StaticResource White}"
                           FontSize="24"
                           FontWeight="Black"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>

            <Button Grid.Row="1"
                    Style="{StaticResource PillButton}"
                    Background="{StaticResource Green}"
                    Content="Neues Spiel"
                    Height="64"
                    FontSize="20"
                    Click="NewMatch_Click"/>
        </Grid>

        <!-- Scroll content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Laufende Spiele"
                           Foreground="{StaticResource White}"
                           FontSize="18" FontWeight="Black"
                           Margin="0,0,0,10"/>

                <Border Style="{StaticResource MatchCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="44" Height="44" Fill="#55FFFFFF" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="guest#97821195" Foreground="{StaticResource White}" FontWeight="Bold"/>
                            <TextBlock Text="Du bist dran" Foreground="#FFFFC857" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PillButton}"
                                Background="{StaticResource Green}"
                                Height="44" FontSize="16"
                                Content="Spielen" Click="OpenMatch_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="Beendete Spiele"
                           Foreground="{StaticResource White}"
                           FontSize="18" FontWeight="Black"
                           Margin="0,18,0,10"/>

                <Border Style="{StaticResource MatchCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="44" Height="44" Fill="#55FFFFFF" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="QuizMaster" Foreground="{StaticResource White}" FontWeight="Bold"/>
                            <TextBlock Text="Beendet • 510 : 540" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PillButton}"
                                Background="{StaticResource BlueBtn}"
                                Height="44" FontSize="16"
                                Content="Ansehen" Click="OpenMatch_Click"/>
                    </Grid>
                </Border>

                <Border Height="24" Background="#00000000"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Overlay: Klassisches Duell -->
        <Grid x:Name="NewGameOverlay" Visibility="Collapsed">
            <Border Background="#AA000000"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18">

                <Border Background="#EFFFFFFF"
                        CornerRadius="26"
                        Padding="18"
                        Width="340">
                    <StackPanel Margin="14">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Klassisches Duell"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="#1E2A6A"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    Width="34" Height="34"
                                    CornerRadius="17"
                                    Background="#E9EEF9">
                                <TextBlock Text="🔍" FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Background="#FF22C55E"
                                    BorderThickness="0"
                                    Height="150"
                                    Margin="0,0,10,0"
                                    Click="FindOpponent_Click"
                                    Cursor="Hand">
                                <Border CornerRadius="22" Padding="16">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                        <Border Width="54" Height="54" CornerRadius="27" Background="#22FFFFFF">
                                            <TextBlock Text="🎲" FontSize="26"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Beliebiger&#10;Spieler"
                                                   TextAlignment="Center"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="Black"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="1"
                                    Background="#FF3B82F6"
                                    BorderThickness="0"
                                    Height="150"
                                    Margin="10,0,0,0"
                                    Click="PlayWithFriend_Click"
                                    Cursor="Hand">
                                <Border CornerRadius="22" Padding="16">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                        <Border Width="54" Height="54" CornerRadius="27" Background="#22FFFFFF">
                                            <TextBlock Text="👥" FontSize="26"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Gegen Freunde&#10;spielen"
                                                   TextAlignment="Center"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="Black"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>

                        <Button Style="{StaticResource PillButton}"
                                Background="{StaticResource BlueBtn}"
                                Content="Freunde einladen"
                                Height="58"
                                FontSize="18"
                                Click="InviteFriends_Click"/>
                    </StackPanel>
                </Border>

                <!-- bottom X -->
                <Button Width="56" Height="56"
                        Background="#00FFFFFF"
                        BorderBrush="#CCFFFFFF"
                        BorderThickness="2"
                        Click="CloseOverlay_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="28"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <TextBlock Text="✕"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Black"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
