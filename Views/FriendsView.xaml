<UserControl x:Class="Quizly.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Überschrift "Freunde" -->
        <TextBlock Grid.Row="0"
                   Text="Freunde"
                   Foreground="{StaticResource White}"
                   FontSize="24" 
                   FontWeight="Black"
                   Margin="0,6,0,14"/>

        <!-- Avatar und Benutzername in der Mitte -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center"
                    Margin="0,10,0,20">
            <Ellipse Width="70" Height="70" 
                     Fill="#4DD4E8" 
                     Margin="0,0,0,10">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="guest#25318401" 
                       Foreground="{StaticResource White}" 
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       x:Name="CurrentUserName"/>
        </StackPanel>

        <!-- Suchbalken und Freundesliste -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#33FFFFFF" CornerRadius="22" Padding="12" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- TextBox mit Placeholder -->
                    <TextBox Background="#00FFFFFF"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="16"
                             x:Name="SearchTextBox"
                             GotFocus="SearchTextBox_GotFocus"
                             LostFocus="SearchTextBox_LostFocus"/>

                    <!-- Placeholder Text -->
                    <TextBlock Text="Freunde suchen"
                               Foreground="#AAFFFFFF"
                               FontSize="16"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"
                               x:Name="PlaceholderText">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1" 
                            Style="{StaticResource CircleButton}" 
                            Content="🔎"
                            Click="Search_Click"/>
                </Grid>
            </Border>

            <Button Grid.Row="1"
                    Style="{StaticResource PillButton}"
                    Background="{StaticResource BlueBtn}"
                    Content="Freunde einladen"
                    Margin="0,14,0,0"
                    Click="Invite_Click"/>

            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Ellipse Width="70" Height="70" Fill="#22FFFFFF"/>
                <TextBlock Text="Lade deine Freunde zu einem Duell ein!"
                           Foreground="{StaticResource White}"
                           FontSize="18" FontWeight="Bold"
                           TextAlignment="Center"/>
                <TextBlock Text="(Demo) Hier später echte Freundesliste."
                           Foreground="{StaticResource Muted}"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- Overlay Invite -->
            <Grid x:Name="InviteOverlay" Visibility="Collapsed" Grid.RowSpan="3">
                <Border Background="#AA000000"/>
                <Border Background="#EFFFFFFF" CornerRadius="22"
                        Padding="18" Width="320"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Margin="14">
                        <TextBlock Text="Freunde einladen"
                                   FontSize="18"
                                   FontWeight="Black"
                                   Foreground="#1E2A6A"
                                   TextAlignment="Center"/>

                        <TextBlock Text="(Demo) Später z.B. Code/Link anzeigen."
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>

                        <Button Style="{StaticResource PillButton}"
                                Background="{StaticResource BlueBtn}"
                                Content="Einladen"
                                Height="50"
                                Click="InviteSend_Click"/>

                        <Button Style="{StaticResource PillButton}"
                                Background="{StaticResource DarkBtn}"
                                Content="Schließen"
                                Height="50"
                                Click="CloseOverlay_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
