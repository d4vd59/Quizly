<UserControl x:Class="Quizly.Views.QuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Style="{StaticResource CircleButton}" Content="←" Click="Back_Click"/>

        <Border Grid.Row="1" Background="#EFFFFFFF" CornerRadius="26" Padding="18" Margin="0,14,0,12">
            <TextBlock Text="(Demo Frage) Hier steht später die echte Frage."
                       Foreground="#FF2B2F6D"
                       FontSize="22"
                       FontWeight="Black"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Background="#33000000" CornerRadius="10" Height="12" Margin="0,0,0,16">
            <Border Background="{StaticResource Green}" CornerRadius="10" Width="320" HorizontalAlignment="Left"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"
                    Style="{StaticResource PillButton}" Background="{StaticResource DarkBtn}"
                    Height="92" Content="Antwort A" Click="Answer_Click"/>

            <Button Grid.Row="0" Grid.Column="1" Margin="10,0,0,10"
                    Style="{StaticResource PillButton}" Background="{StaticResource DarkBtn}"
                    Height="92" Content="Antwort B" Click="Answer_Click"/>

            <Button Grid.Row="1" Grid.Column="0" Margin="0,10,10,0"
                    Style="{StaticResource PillButton}" Background="{StaticResource DarkBtn}"
                    Height="92" Content="Antwort C" Click="Answer_Click"/>

            <Button Grid.Row="1" Grid.Column="1" Margin="10,10,0,0"
                    Style="{StaticResource PillButton}" Background="{StaticResource DarkBtn}"
                    Height="92" Content="Antwort D" Click="Answer_Click"/>
        </Grid>
    </Grid>
</UserControl>
