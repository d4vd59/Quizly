<UserControl x:Class="Quizly.Views.MatchmakingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource CircleButton}" Content="←" Click="Back_Click"/>

            <TextBlock Grid.Column="1"
                       Text="Gegner wird gesucht…"
                       Foreground="{StaticResource White}"
                       FontSize="18"
                       FontWeight="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardStrong}" CornerRadius="26" Padding="18">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                <Ellipse Width="86" Height="86" Fill="#33FFFFFF"/>
                <TextBlock Text="Matchmaking läuft"
                           Foreground="{StaticResource White}"
                           FontSize="22"
                           FontWeight="Black"
                           HorizontalAlignment="Center"/>
                <ProgressBar Width="260" Height="10" IsIndeterminate="True"/>
                <TextBlock Text="(Demo) Später echte Server-Suche."
                           Foreground="{StaticResource Muted}"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Style="{StaticResource PillButton}"
                Background="{StaticResource Green}"
                Content="Gegner gefunden (Demo)"
                Margin="0,14,0,0"
                Click="Found_Click"/>
    </Grid>
</UserControl>
