<UserControl x:Class="Quizly.Views.MatchmakingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF0F172A">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="←"
                    Width="40" Height="40"
                    Background="#1F2937" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="Back_Click"/>

            <TextBlock Grid.Column="1"
                       Text="Suche Gegner…"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="#111B33" CornerRadius="18" Padding="16">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                <TextBlock Text="Matchmaking läuft"
                           Foreground="#93C5FD" FontWeight="SemiBold"/>

                <TextBlock Text="Bitte warten…"
                           Foreground="White" FontSize="22" FontWeight="Bold"/>

                <ProgressBar Width="260" Height="10" IsIndeterminate="True"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Content="Gegner gefunden (Demo)"
                Height="56"
                Background="#60A5FA" Foreground="White"
                FontWeight="Bold" BorderThickness="0"
                Cursor="Hand"
                Margin="0,14,0,0"
                Click="Found_Click"/>
    </Grid>
</UserControl>
