<UserControl x:Class="Quizly.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="16">
            <Border Background="#33FFFFFF" CornerRadius="26" Padding="18">
                <TextBlock Text="Ergebnis (Demo)"
                           Foreground="{StaticResource White}"
                           FontSize="28" FontWeight="Black"
                           TextAlignment="Center"/>
            </Border>

            <TextBlock Text="Hier kommt später richtig/falsch + Punkte."
                       Foreground="{StaticResource Muted}"
                       TextAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="1" Style="{StaticResource PillButton}"
                Background="{StaticResource Green}"
                Content="Weiter"
                Margin="0,16,0,0"
                Click="Next_Click"/>
    </Grid>
</UserControl>
