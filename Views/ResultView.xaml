<UserControl x:Class="Quizly.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Nur Zurück-Button -->
        <Grid Grid.Row="0" Margin="0,10,0,20">
            <Button HorizontalAlignment="Left"
                    Style="{StaticResource CircleButton}" 
                    Content="←" 
                    Click="Back_Click"/>
        </Grid>

        <!-- Status-Text und Score -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- "Du bist dran" Text -->
            <TextBlock Grid.Row="0"
                       Text="Du bist dran"
                       Foreground="#FFC857"
                       FontSize="36" 
                       FontWeight="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       x:Name="StatusText"/>

            <!-- Score und Spieler -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Linker Spieler -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="90" Height="90" Fill="#4DD4E8" Margin="0,0,0,10">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="guest#25318401" 
                               Foreground="{StaticResource White}" 
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               x:Name="Player1Name"/>
                </StackPanel>

                <!-- Score in der Mitte -->
                <TextBlock Grid.Column="1"
                           Text="0  -  2"
                           Foreground="{StaticResource White}"
                           FontSize="64" 
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="20,0"
                           x:Name="FinalScore"/>

                <!-- Rechter Spieler -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="90" Height="90" Fill="#FF8C42" Margin="0,0,0,10">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Fleetwater" 
                               Foreground="{StaticResource White}" 
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               x:Name="Player2Name"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Runden-Übersicht -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Runde 1: Computerspiele -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Spieler 1 Ellipsen -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#E91E63" Margin="0,0,8,0" x:Name="R1Q1Player1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="50" Height="50" Fill="#E91E63" Margin="0,0,8,0" x:Name="R1Q2Player1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="50" Height="50" Fill="#E91E63" x:Name="R1Q3Player1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>

                    <!-- Icon + Text in der Mitte -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                        <Border Background="#4D5B9E" 
                                Width="80" Height="80" 
                                CornerRadius="40"
                                Margin="0,0,0,8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="🕹" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="R1Icon"/>
                        </Border>
                        <TextBlock Text="Computerspiele" 
                                   Foreground="{StaticResource White}" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   x:Name="R1Category"/>
                    </StackPanel>

                    <!-- Spieler 2 Ellipsen -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#E91E63" Margin="0,0,8,0" x:Name="R1Q1Player2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="50" Height="50" Fill="#4CAF50" Margin="0,0,8,0" x:Name="R1Q2Player2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="50" Height="50" Fill="#E91E63" x:Name="R1Q3Player2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>
                </Grid>

                <!-- Runde 2: TV-Serien -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#E91E63" Margin="0,0,8,0" x:Name="R2Q1Player1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="50" Height="50" Fill="#E91E63" Margin="0,0,8,0" x:Name="R2Q2Player1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="50" Height="50" Fill="#E91E63" x:Name="R2Q3Player1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                        <Border Background="#4D5B9E" Width="80" Height="80" CornerRadius="40" Margin="0,0,0,8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="📺" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="R2Icon"/>
                        </Border>
                        <TextBlock Text="TV-Serien" Foreground="{StaticResource White}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" x:Name="R2Category"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#4CAF50" Margin="0,0,8,0" x:Name="R2Q1Player2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="50" Height="50" Fill="#E91E63" Margin="0,0,8,0" x:Name="R2Q2Player2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="50" Height="50" Fill="#E91E63" x:Name="R2Q3Player2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>
                </Grid>

                <!-- Runden 3-6: Noch nicht gespielt (dunkelblau, transparent) -->
                <!-- Runde 3 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                        <Border Background="#1A2A5E" Width="80" Height="80" CornerRadius="40" Margin="0,0,0,8" Opacity="0.5">
                            <TextBlock Text="3" Foreground="{StaticResource White}" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                </Grid>

                <!-- Runde 4 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                        <Border Background="#1A2A5E" Width="80" Height="80" CornerRadius="40" Margin="0,0,0,8" Opacity="0.5">
                            <TextBlock Text="4" Foreground="{StaticResource White}" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                </Grid>

                <!-- Runde 5 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                        <Border Background="#1A2A5E" Width="80" Height="80" CornerRadius="40" Margin="0,0,0,8" Opacity="0.5">
                            <TextBlock Text="5" Foreground="{StaticResource White}" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                </Grid>

                <!-- Runde 6 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                        <Border Background="#1A2A5E" Width="80" Height="80" CornerRadius="40" Margin="0,0,0,8" Opacity="0.5">
                            <TextBlock Text="6" Foreground="{StaticResource White}" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Margin="0,0,8,0" Opacity="0.5"/>
                        <Ellipse Width="50" Height="50" Fill="#1A2A5E" Opacity="0.5"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Button unten -->
        <Button Grid.Row="3"
                Style="{StaticResource PillButton}"
                Background="{StaticResource Green}"
                Content="Nochmal Spielen"
                Margin="0,20,0,0"
                Height="60"
                FontSize="22"
                FontWeight="Bold"
                Click="PlayAgain_Click"/>
    </Grid>
</UserControl>