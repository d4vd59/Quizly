<UserControl x:Class="Quizly.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF0F172A">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="←"
                    Width="40" Height="40"
                    Background="#1F2937" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="Back_Click"/>

            <TextBlock Grid.Column="1"
                       Text="Ergebnis"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="#111B33" CornerRadius="18" Padding="16">
            <StackPanel Margin="12">
                <TextBlock Text="✅ Richtig! (Demo)"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"/>

                <TextBlock Text="Punkte: +180"
                           Foreground="#93C5FD"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <TextBlock Text="(Später kommt das aus Python)"
                           Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Weiter"
                    Height="56"
                    Background="#60A5FA"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Next_Click"/>

            <Button Grid.Column="1"
                    Content="Match-Ende (Demo)"
                    Height="56"
                    Background="#1F2937"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="12,0,0,0"
                    Click="MatchEnd_Click"/>
        </Grid>
    </Grid>
</UserControl>
