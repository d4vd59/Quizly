<UserControl x:Class="Quizly.Views.CategoryPickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <UserControl.Resources>
        <!-- Animation für Kategorie-Auswahl -->
        <Storyboard x:Key="SelectAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="1.05" Duration="0:0:0.15" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="1.05" Duration="0:0:0.15" AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header mit Zurück-Button (ausgeblendet) -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ✅ GEÄNDERT: Zurück-Button ausgeblendet + Name hinzugefügt -->
            <Button x:Name="BackButton"
                    Style="{StaticResource CircleButton}" 
                    Content="←" 
                    Click="Back_Click"
                    Visibility="Collapsed"/>

            <TextBlock Grid.Column="1" 
                       Text="Wähle eine Kategorie"
                       Foreground="{StaticResource White}"
                       FontSize="28" 
                       FontWeight="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Spieler Info: Wer ist dran? -->
        <Border Grid.Row="1" 
                Background="#66000000" 
                CornerRadius="20" 
                Padding="16,10"
                Margin="0,0,0,20"
                HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="32" Height="32" 
                         Fill="#4DD4E8" 
                         Margin="0,0,12,0"
                         x:Name="CurrentPlayerAvatar"/>
                <TextBlock Text="Du bist dran!" 
                           Foreground="{StaticResource White}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           x:Name="CurrentPlayerText"/>
            </StackPanel>
        </Border>

        <!-- Kategorie-Buttons -->
        <StackPanel Grid.Row="2" 
                    VerticalAlignment="Center" 
                    Margin="0,0,0,20">

            <!-- Kategorie 1 -->
            <Border Background="#33FFFFFF" 
                    CornerRadius="26" 
                    Height="110" 
                    Margin="0,0,0,16"
                    Cursor="Hand"
                    MouseLeftButtonDown="Category_Click"
                    x:Name="Category1Border"
                    Tag="0">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" CenterX="190" CenterY="55"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.2"/>
                </Border.Effect>
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Kategorie 1" 
                                   Foreground="{StaticResource White}" 
                                   FontSize="24" 
                                   FontWeight="Black"
                                   x:Name="Category1Name"/>
                        <TextBlock Text="Beschreibung..." 
                                   Foreground="#CCFFFFFF" 
                                   FontSize="14" 
                                   Margin="0,4,0,0"
                                   x:Name="Category1Desc"/>
                    </StackPanel>
                    <TextBlock Text="🏅" 
                               FontSize="32" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"
                               x:Name="Category1Icon"/>
                </Grid>
            </Border>

            <!-- Kategorie 2 -->
            <Border Background="#33FFFFFF" 
                    CornerRadius="26" 
                    Height="110" 
                    Margin="0,0,0,16"
                    Cursor="Hand"
                    MouseLeftButtonDown="Category_Click"
                    x:Name="Category2Border"
                    Tag="1">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" CenterX="190" CenterY="55"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.2"/>
                </Border.Effect>
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Kategorie 2" 
                                   Foreground="{StaticResource White}" 
                                   FontSize="24" 
                                   FontWeight="Black"
                                   x:Name="Category2Name"/>
                        <TextBlock Text="Beschreibung..." 
                                   Foreground="#CCFFFFFF" 
                                   FontSize="14" 
                                   Margin="0,4,0,0"
                                   x:Name="Category2Desc"/>
                    </StackPanel>
                    <TextBlock Text="🎵" 
                               FontSize="32" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"
                               x:Name="Category2Icon"/>
                </Grid>
            </Border>

            <!-- Kategorie 3 -->
            <Border Background="#33FFFFFF" 
                    CornerRadius="26" 
                    Height="110" 
                    Margin="0,0,0,0"
                    Cursor="Hand"
                    MouseLeftButtonDown="Category_Click"
                    x:Name="Category3Border"
                    Tag="2">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" CenterX="190" CenterY="55"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.2"/>
                </Border.Effect>
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Kategorie 3" 
                                   Foreground="{StaticResource White}" 
                                   FontSize="24" 
                                   FontWeight="Black"
                                   x:Name="Category3Name"/>
                        <TextBlock Text="Beschreibung..." 
                                   Foreground="#CCFFFFFF" 
                                   FontSize="14" 
                                   Margin="0,4,0,0"
                                   x:Name="Category3Desc"/>
                    </StackPanel>
                    <TextBlock Text="🕹" 
                               FontSize="32" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"
                               x:Name="Category3Icon"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
