<UserControl x:Class="Quizly.Views.MatchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF0F172A">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Match Ergebnis"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1" Background="#111B33" CornerRadius="18" Padding="16">
            <StackPanel Margin="10">
                <TextBlock Text="Du: 540" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Gegner: 510" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="🏆 Du hast gewonnen! (Demo)" Foreground="#93C5FD" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Menü"
                    Height="56"
                    Background="#1F2937"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Menu_Click"/>

            <Button Grid.Column="1"
                    Content="Rematch"
                    Height="56"
                    Background="#60A5FA"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="12,0,0,0"
                    Click="Rematch_Click"/>
        </Grid>
    </Grid>
</UserControl>
