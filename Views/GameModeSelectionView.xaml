<UserControl x:Class="Quizly.Views.GameModeSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header mit Zurück-Button -->
        <Grid Grid.Row="0" Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource CircleButton}" Content="←" Click="Back_Click"/>

            <TextBlock Grid.Column="1"
                       Text="Spielmodus wählen"
                       Foreground="{StaticResource White}"
                       FontSize="20"
                       FontWeight="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Auswahl Buttons -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,40">
            <!-- Multiplayer Button -->
            <Border Background="{StaticResource CardStrong}" 
                    CornerRadius="26" 
                    Padding="24"
                    Margin="0,0,0,16"
                    Cursor="Hand"
                    MouseLeftButtonDown="Multiplayer_Click">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="👥" 
                               FontSize="60" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Multiplayer" 
                               Foreground="{StaticResource White}" 
                               FontSize="24"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Spiele gegen echte Gegner" 
                               Foreground="{StaticResource Muted}" 
                               FontSize="13"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Singleplayer Button -->
            <Border Background="{StaticResource CardStrong}" 
                    CornerRadius="26" 
                    Padding="24"
                    Cursor="Hand"
                    MouseLeftButtonDown="Singleplayer_Click">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎮" 
                               FontSize="60" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Singleplayer" 
                               Foreground="{StaticResource White}" 
                               FontSize="24"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Spiele alleine und trainiere" 
                               Foreground="{StaticResource Muted}" 
                               FontSize="13"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
