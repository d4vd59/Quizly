<Window x:Class="Quizly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quizly.Views"
        Title="Quizly" Icon="/resources/logo.png"
        Height="780" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hier wechseln die Screens -->
        <ContentControl x:Name="MainContent" Grid.Row="0"/>

        <!-- Bottom Tabs bleiben immer sichtbar -->
        <views:BottomNavBar Grid.Row="1" x:Name="BottomBar"/>
    </Grid>
</Window>
